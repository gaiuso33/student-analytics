# Copy to .env and fill in. Never commit .env.

# REQUIRED. Signs login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the site is served (see Caddyfile): a domain for automatic HTTPS, or "localhost" for a local trial.
SITE_ADDRESS=localhost

# First-run administrator (only used while there are no users). Choose a long password.
# If ADMIN_PASSWORD is empty, a random one is printed once in the backend logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Keep 0 in production. 1 fills an empty database with 40 fake students.
SEED_DEMO_DATA=0

# Business rules
PASS_MARK=60
AT_RISK_GPA=2.0

# Sign-in lifetime in seconds (default 8 hours)
TOKEN_MAX_AGE=28800
