# Copy to .env and fill in. Never commit .env.

# REQUIRED. Signs login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the site is served (see Caddyfile): a domain for automatic HTTPS, or "localhost" for a local trial.
SITE_ADDRESS=localhost

# First-run administrator (only used while there are no users). Choose a long password.
# If ADMIN_PASSWORD is empty, a random one is printed once in the backend logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Keep 0 in production. 1 fills an empty database with 40 fake students.
SEED_DEMO_DATA=0

# Business rules
PASS_MARK=60
AT_RISK_GPA=2.0

# Sign-in lifetime in seconds (default 8 hours)
TOKEN_MAX_AGE=28800

# --- Reminder emails (optional) ---
# Staff and administrators who set an email address on their Account page get one short digest of their
# overdue / due-soon follow-ups. Nothing is sent unless SMTP_HOST is set AND the command is scheduled (see README).
# Follow-ups count as "due soon" this many days ahead:
REMINDER_DAYS_AHEAD=2
# Address used in the link inside the emails (your site's public address):
SITE_URL=
# Your mail provider's SMTP details (any provider that offers SMTP). Leave SMTP_HOST empty to keep emails off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Shown as the sender, e.g. "Student Analytics <noreply@yourschool.org>"; defaults to SMTP_USER
MAIL_FROM=
# 0 = emails only say how many follow-ups need attention (recommended). 1 = also list student names. Notes are never included.
REMINDER_INCLUDE_NAMES=0
