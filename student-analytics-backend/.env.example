# All optional; defaults shown
DATABASE=students.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PASS_MARK=60
AT_RISK_GPA=2.0

# --- authentication ---
# REQUIRED in production: a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a temporary key is used and everyone is signed out on every restart.
SECRET_KEY=
TOKEN_MAX_AGE=28800
# Only used on first run, when there are no users yet. If ADMIN_PASSWORD is empty,
# a random password is printed to the terminal once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SECONDS=60
